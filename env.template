# Copy this file to .env.local for development and set values.
# Set the same variables in your hosting provider for production.

# Database
DATABASE_URL="file:./prisma/dev.db"
# Example Postgres for production:
# DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# NextAuth v5
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-long-random-string"

# NextAuth v4 (for backward compatibility)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-string"

# GitHub OAuth (NextAuth)
GITHUB_ID=""
GITHUB_SECRET=""

# OpenAI
OPENAI_API_KEY=""

# Google Gemini
GEMINI_API_KEY=""

# Resend Email
RESEND_API_KEY=""
RESEND_FROM="Your Name <no-reply@yourdomain.com>"

# Optional: Protect email dispatch endpoint
DISPATCH_TOKEN=""
